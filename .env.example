# Copy to .env.local (gitignored) and fill in real values.

# Neon/Vercel Postgres -- backs bookings, contact_messages, and
# newsletter_signups (see db/vercel.ts). Until set, those features no-op
# gracefully instead of erroring.
DATABASE_URL=

# Contact form email delivery via Resend (app/api/contact/route.ts).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Custom CRM (peptides-crm-app), shared with evlv-site. CRM_API_URL is the
# same value evlv-site uses -- where peptides-crm-app is deployed, e.g.
# https://crm.evlvpeptides.com.
CRM_API_URL=

# Booking form (app/api/bookings/route.ts) -- a public per-brand key, not
# the full org API key, since bookings are meant to post straight through
# without exposing anything sensitive. Same CRM_BOOKING_FORM_KEY pattern as
# evlv-site's CRM_CONTACT_FORM_KEY.
CRM_BOOKING_FORM_KEY=

# Newsletter signup (app/api/newsletter/route.ts) -- proxies to the CRM's
# /api/store/newsletter via lib/crm-proxy.ts, same CRM_ORG_API_KEY/
# CRM_STORE_DOMAIN pair evlv-site uses, so an evlv.bio signup lands as a
# real CRM Contact (marketingOptIn=true), gets a genuine single-use welcome
# coupon, and is pushed to Omnisend -- instead of only landing in this
# app's own local newsletter_signups table.
#   CRM_ORG_API_KEY  — your Organization.apiKey from the CRM's Settings/Webhooks page
#   CRM_STORE_DOMAIN — the domain the EVLV Brand row is registered under in the CRM (e.g. evlvpeptides.com)
CRM_ORG_API_KEY=
CRM_STORE_DOMAIN=
